---
import { model } from '../lib/data';
import SocialIcon from './SocialIcon.astro';
import { url, t, pageUrl, type Lang } from '../lib/site';
interface Props { lang: Lang; current?: string; alt?: string }
const { lang, current, alt } = Astro.props;
const nav = model().navigation;
const homeHref = url(lang === 'en' ? '/en/' : '/');
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={homeHref} aria-current={current === 'domu' ? 'page' : undefined}>
      <img class="emblem" src={url('/brand/emblem.svg')} alt="" width="88" height="88" />
      <img class="wordmark" src={url('/brand/wordmark-carrom-cz-white.svg')} alt={lang === 'en' ? 'carrom.cz · Czech Carrom Association' : 'carrom.cz · Česká carromová asociace'} width="217" height="29" />
    </a>
    <nav class="main-nav" aria-label={lang === 'en' ? 'Main menu' : 'Hlavní menu'}>
      {(nav.main ?? []).map((item: any) => (
        <a href={pageUrl(item, lang)} aria-current={current === item.page ? 'page' : undefined}>{t(item.label, lang)}</a>
      ))}
    </nav>
    <div class="tools">
      {(nav.social ?? []).map((sx: any) => (
        <a class="social" href={sx.url} rel="noopener" aria-label={t(sx.label, lang)} title={t(sx.label, lang)}>
          <SocialIcon name={sx.icon} />
        </a>
      ))}
      <a class="lang" href={alt ?? url(lang === 'en' ? '/' : '/en/')} lang={lang === 'en' ? 'cs' : 'en'}><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>{lang === 'en' ? 'CZ' : 'EN'}</a>
      {nav.cta && <a class="btn btn-red cta" href={pageUrl(nav.cta, lang)}>{t(nav.cta.label, lang)}</a>}
    </div>
  </div>
</header>
<style>
  /* The emblem is larger than the bar and hangs below it (Ondrej, 2026-11-26). */
  .site-header { background: var(--navy); position: relative; z-index: 20; }
  .bar { display: flex; align-items: center; gap: 16px; height: 68px; }
  .logo { position: relative; align-self: stretch; display: flex; align-items: center; flex: none; padding-left: 68px; }
  .emblem { position: absolute; left: 0; top: 6px; width: 60px; height: 60px; border-radius: 50%; box-shadow: 0 0 0 3px var(--navy), 0 4px 12px rgba(14, 27, 61, 0.3); }
  .wordmark { display: block; width: 150px; height: 20px; }
  @media (min-width: 360px) {
    .logo { padding-left: 78px; }
    .emblem { width: 68px; height: 68px; }
    .wordmark { width: 176px; height: 24px; }
  }
  @media (min-width: 400px) {
    .logo { padding-left: 86px; }
    .emblem { top: 7px; width: 76px; height: 76px; }
    .wordmark { width: 194px; height: 26px; }
  }
  .main-nav { display: none; gap: 24px; align-items: center; }
  .main-nav a { color: var(--on-navy); font-size: 16px; font-weight: 500; padding: 6px 0; white-space: nowrap; }
  .main-nav a:hover { color: #fff; }
  .main-nav a[aria-current='page'] { color: #fff; font-weight: 700; box-shadow: inset 0 -2px 0 var(--red); }
  .tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }
  .lang { height: 44px; min-width: 44px; padding: 0 8px; display: flex; align-items: center; justify-content: center; gap: 6px; border-radius: 6px; color: #fff; font-size: 14px; font-weight: 700; }
  .lang:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .social { display: none; width: 36px; height: 36px; align-items: center; justify-content: center; border-radius: 6px; color: var(--on-navy); }
  .social:hover { background: rgba(255, 255, 255, 0.08); }
  .cta { display: none; min-height: 44px; padding: 0 20px; }
  @media (min-width: 1100px) {
    .bar { gap: 20px; }
    .main-nav { gap: 18px; }
    .logo { padding-left: 102px; }
    .emblem { top: 8px; width: 88px; height: 88px; box-shadow: 0 0 0 4px var(--navy), 0 6px 16px rgba(14, 27, 61, 0.3); }
    .wordmark { width: 217px; height: 29px; }
    .main-nav { display: flex; }
    .cta { display: inline-flex; white-space: nowrap; }
    .lang { height: 32px; }
  }
  /* Social icons from tablet width up; at 1100–1199 px the full menu needs the room, so they move to the footer (Ondrej 2026-11-28). */
  @media (min-width: 560px) and (max-width: 1099px), (min-width: 1200px) {
    .social { display: inline-flex; }
  }
  @media (min-width: 1280px) {
    .bar { gap: 28px; }
    .main-nav { gap: 24px; }
  }
</style>
