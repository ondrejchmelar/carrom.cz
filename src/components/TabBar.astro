---
import { model } from '../lib/data';
import { t, pageUrl, type Lang } from '../lib/site';
import Icon from './Icon.astro';
interface Props { lang: Lang; current?: string }
const { lang, current } = Astro.props;
const items = model().navigation.tabbar ?? [];
---
<nav class="tabbar" aria-label={lang === 'en' ? 'Quick menu' : 'Rychlé menu'}>
  {items.map((item: any) => (
    <a href={pageUrl(item, lang)} aria-current={current === item.page ? 'page' : undefined}>
      <Icon name={item.icon ?? 'menu'} />
      <span>{t(item.label, lang)}</span>
    </a>
  ))}
</nav>
<style>
  .tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; height: calc(var(--tabbar-h) + env(safe-area-inset-bottom, 0px)); padding-bottom: env(safe-area-inset-bottom, 0px); background: #fff; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .tabbar a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; font-size: 12px; font-weight: 600; color: var(--muted); }
  .tabbar a[aria-current='page'] { color: var(--red); font-weight: 700; }
  @media (min-width: 1100px) { .tabbar { display: none; } }
</style>
