---
// Playable carrom board (canvas). Engine and computer opponent: src/lib/core/carrom.js.
import { nbsp } from '../lib/site';
interface Props { lang?: 'cs' | 'en' }
const { lang = 'cs' } = Astro.props;
const T = {
  cs: {
    vs: 'Proti počítači', two: 'Dva hráči', level: 'Obtížnost', easy: 'Lehká', mid: 'Střední', hard: 'Těžká',
    reset: 'Nová hra', place: 'Pozice strikeru', board: 'Carromová deska, hra',
    help: 'Posuň striker po své čáře (táhni ho). Pak táhni prstem nebo myší od strikeru dozadu, jako prak, a pusť. Čím dál táhneš, tím silněji cvrnkneš.',
    keys: 'Klávesnice: ← → posun, ↑ ↓ míření, mezerník síla a výstřel.',
  },
  en: {
    vs: 'Against computer', two: 'Two players', level: 'Level', easy: 'Easy', mid: 'Medium', hard: 'Hard',
    reset: 'New game', place: 'Striker position', board: 'Carrom board, game',
    help: 'Slide the striker along your base line (drag it). Then drag back from the striker like a slingshot and let go. The further you pull, the harder the shot.',
    keys: 'Keyboard: ← → move, ↑ ↓ aim, space for power and shot.',
  },
}[lang];
---
<div class="cg" data-lang={lang}>
  <div class="cg-bar">
    <div class="chips" role="group" aria-label={lang === 'en' ? 'Mode' : 'Režim'}>
      <button type="button" class="chip" data-mode="computer" aria-pressed="true">{T.vs}</button>
      <button type="button" class="chip" data-mode="two" aria-pressed="false">{T.two}</button>
    </div>
    <label class="cg-level">
      <span>{T.level}</span>
      <select data-level>
        <option value="easy" selected>{T.easy}</option>
        <option value="mid">{T.mid}</option>
        <option value="hard">{T.hard}</option>
      </select>
    </label>
  </div>

  <div class="cg-score" aria-live="polite">
    <span class="cg-side" data-side="white"><i class="dot w"></i><span><b data-count="white">0</b>/<span data-total>3</span></span><span data-name="white"></span></span>
    <span class="cg-queen" data-queen></span>
    <span class="cg-side" data-side="black"><span data-name="black"></span><span><b data-count="black">0</b>/<span data-total>3</span></span><i class="dot b"></i></span>
  </div>

  <div class="cg-stage">
    <canvas tabindex="0" aria-label={T.board} aria-describedby="cg-help"></canvas>
    <div class="cg-start" data-start hidden><i class="dot w"></i><span data-start-text></span></div>
    <div class="cg-over" data-over hidden>
      <strong data-over-title></strong>
      <span data-over-text></span>
      <button type="button" class="btn btn-red" data-again>{T.reset}</button>
    </div>
  </div>

  <p class="cg-status" data-status aria-live="polite"></p>
  <p class="cg-rules small" data-rules></p>


  <div class="cg-foot">
    <button type="button" class="btn btn-ghost" data-reset>{T.reset}</button>
  </div>
  <p id="cg-help" class="small">{nbsp(T.help)} <span class="cg-keys">{T.keys}</span></p>
</div>

<script>
  import * as C from '../lib/core/carrom.js';

  const TXT = {
    cs: {
      you: 'Ty', cpu: 'Počítač', p1: 'Hráč 1', p2: 'Hráč 2', white: 'bílé', black: 'černé',
      yourTurn: (c: string) => `Jsi na tahu, hraješ ${c}.`, youBreak: 'Začínáš ty, a proto máš bílé kameny. Rozstřel!', cpuBreaks: 'Tuhle sadu začíná počítač, a proto má bílé. Ty máš černé.', starts: (n: string) => `Začíná ${n}, a proto má bílé kameny. Rozstřel!`,
      badgeYou: 'Začínáš ty: máš bílé', badgeCpu: 'Začíná počítač: má bílé', badge: (n: string) => `Začíná ${n}: má bílé`, cpuThinks: 'Počítač přemýšlí…', cpuShoots: 'Hraje počítač.',
      turnOf: (n: string, c: string) => `Na tahu: ${n} (${c}).`,
      blocked: 'Striker nesmí ležet na kameni. Posuň ho.',
      own: 'Kámen v díře, hraješ znovu.', theirs: 'Do díry šel soupeřův kámen.', miss: 'Nic nespadlo.',
      foul: 'Faul: striker v díře. Jeden tvůj kámen jde zpět na desku (nemáš-li žádný, dlužíš ho) a tah končí.',
      'foul-on': 'Faul: striker v díře. Kameny z tohoto šťouchu a jeden navíc jdou zpět, ale hraješ dál.',
      'break-retry': 'Při rozstřelu musí striker trefit kámen. Zkus to znovu (máš tři pokusy).',
      'break-lost': 'Rozstřel se nepovedl, hraje soupeř.',
      'queen-due': 'Dokud dlužíš kámen, královnu dát nelze. Vrací se doprostřed a tah končí.',
      'due-paid': 'Dlužný kámen se vrací na desku.',
      pending: 'Královna v díře! Teď ji potvrď svým kamenem.', covered: 'Královna potvrzená (+3 body).',
      'queen-back': 'Královnu se nepodařilo potvrdit, vrací se doprostřed.',
      'queen-early': 'Královnu lze dát až po prvním vlastním kameni. Vrací se doprostřed.',
      reason: {
        'last-own': 'Poslední vlastní kámen padl dřív, než byla královna potvrzená.',
        'last-their': 'Padl poslední soupeřův kámen, zatímco královna byla ještě na desce.',
        'last-own-striker': 'Poslední vlastní kámen padl se strikerem dřív než královna.',
        'last-their-striker': 'Poslední soupeřův kámen padl se strikerem, královna byla na desce.',
        'both-last': 'Padly oba poslední kameny, královna zůstala na desce.',
        'both-last-covered': 'Padly oba poslední kameny najednou.',
      } as Record<string, string>,
      'queen-easy': 'Královna v díře (+3 body), hraješ znovu.', 'foul-easy': 'Striker v díře, na tahu je soupeř.', 'foul-easy-on': 'Striker v díře, ale tvůj kámen se počítá a hraješ dál.',
      'queen-first': 'Královna musí být potvrzená dřív než poslední kámen. Kámen se vrací doprostřed.',
      queen: { board: 'Královna na desce', pending: 'Královna čeká na potvrzení', covered: 'Královna potvrzená', easy: 'Královna v díře' },
      rules: {
        easy: 'Kdo začíná, má bílé kameny; začíná se střídavě. Lehká hra: 3 kameny na hráče a královna. Každý kámen v díře se počítá, nic se nevrací. Když dáš svůj kámen nebo královnu, hraješ dál. Královnu musíš potvrdit svým kamenem (hned nebo dalším šťouchem), pak dává +3 body. Potvrdit ji musí někdo dřív, než padne poslední kámen. Vyhrává, kdo má první venku své 3 kameny.',
        full: 'Pravidla ECC: kdo začíná (rozstřeluje), má bílé kameny; začíná se střídavě. 9 kamenů na hráče. Rozstřel musí trefit kámen (tři pokusy). Královnu smíš dát až po svém prvním kameni a musíš ji potvrdit. Soupeřův kámen v díře není faul, zůstává venku a počítá se soupeři. Za striker v díře vracíš kámen (dluh). Poslední kámen před královnou znamená prohranou sadu.',
      },
      won: (n: string) => `${n} vyhrává!`, lost: 'Vyhrál počítač.', pts: (p: number) => `Sada za ${p} ${p === 1 ? 'bod' : p < 5 ? 'body' : 'bodů'}.`,
      youWon: 'Vyhráváš!', aimHint: 'Táhni dozadu a pusť.',
    },
    en: {
      you: 'You', cpu: 'Computer', p1: 'Player 1', p2: 'Player 2', white: 'white', black: 'black',
      yourTurn: (c: string) => `Your turn, you play ${c}.`, youBreak: 'You begin, so you have the white coins. Break!', cpuBreaks: 'The computer begins this board, so it has white. You have black.', starts: (n: string) => `${n} begins, so they have the white coins. Break!`,
      badgeYou: 'You begin: you have white', badgeCpu: 'Computer begins: it has white', badge: (n: string) => `${n} begins: white`, cpuThinks: 'Computer is thinking…', cpuShoots: 'Computer shoots.',
      turnOf: (n: string, c: string) => `${n} to play (${c}).`,
      blocked: 'The striker may not touch a coin. Move it.',
      own: 'Pocketed, shoot again.', theirs: 'An opponent coin went in.', miss: 'Nothing went in.',
      foul: 'Foul: striker pocketed. One of your coins goes back (owed if you have none) and your turn ends.',
      'foul-on': 'Foul: striker pocketed. This stroke\'s coins and one more go back, but you play on.',
      'break-retry': 'On the break the striker must touch a coin. Try again (three attempts).',
      'break-lost': 'The break failed, your opponent plays.',
      'queen-due': 'While you owe a coin the queen cannot be pocketed. Back to the centre, turn over.',
      'due-paid': 'The owed coin goes back on the board.',
      pending: 'Queen pocketed! Now cover it with your coin.', covered: 'Queen covered (+3 points).',
      'queen-back': 'Queen not covered, back to the centre.',
      'queen-early': 'The queen counts only after your first coin. Back to the centre.',
      reason: {
        'last-own': 'The last own coin went in before the queen was covered.',
        'last-their': "The opponent's last coin went in while the queen was still on the board.",
        'last-own-striker': 'The last own coin went in with the striker before the queen.',
        'last-their-striker': "The opponent's last coin went in with the striker, queen on the board.",
        'both-last': 'Both last coins went in with the queen still on the board.',
        'both-last-covered': 'Both last coins went in together.',
      } as Record<string, string>,
      'queen-easy': 'Queen pocketed (+3 points), shoot again.', 'foul-easy': 'Striker pocketed, your turn ends.', 'foul-easy-on': 'Striker pocketed, but your coin counts and you play on.',
      'queen-first': 'The queen must be covered before the last coin. The coin goes back to the centre.',
      queen: { board: 'Queen on the board', pending: 'Queen waiting to be covered', covered: 'Queen covered', easy: 'Queen pocketed' },
      rules: {
        easy: 'Whoever begins has the white coins; players take turns to begin. Easy game: 3 coins each and the queen. Every pocketed coin counts, nothing goes back. Pocket your coin or the queen and you play on. Cover the queen with your coin (same or next stroke) for +3. It must be covered before anyone\'s last coin. First to pocket all 3 coins wins.',
        full: 'ECC laws: whoever begins (breaks) has the white coins; players take turns to begin. 9 coins each. The break must touch a coin (three attempts). The queen may go in only after your first coin and must be covered. An opponent coin in a pocket is no foul, it stays out and counts for them. A pocketed striker costs a coin (a due). Your last coin before the queen loses the board.',
      },
      won: (n: string) => `${n} wins!`, lost: 'The computer wins.', pts: (p: number) => `Board won by ${p} point${p === 1 ? '' : 's'}.`,
      youWon: 'You win!', aimHint: 'Pull back and let go.',
    },
  };

  const COL = { frame: '#3B2416', frame2: '#4A2F1D', birch: '#E8D3A9', birch2: '#E2C995', navy: '#0E1B3D', red: '#D3242B', white: '#FBF7EE', black: '#1D2233', amber: '#F2B33D' };
  const FRAME = 30; // frame width in board mm

  // Czech typography: no line break after one-letter prepositions and conjunctions.
  const nb = (t: string) => t.replace(/(^|[\s(])([vaskzouiVASKZOUI]) /g, '$1$2\u00a0');

  for (const root of document.querySelectorAll<HTMLElement>('.cg')) setup(root);

  function setup(root: HTMLElement) {
    const L = TXT[(root.dataset.lang as 'cs' | 'en') ?? 'cs'];
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const levelSel = $('[data-level]') as HTMLSelectElement;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let mode: 'computer' | 'two' = 'computer';
    const SKILL: Record<string, number> = { mid: 0.6, hard: 0.9 };
    const easy = () => levelSel.value === 'easy';
    let state = C.newGame({ mode, easy: easy() });
    let strikerX = C.CENTER;
    let aim: null | { px: number; py: number } = null;     // pointer position while aiming (board coords)
    let drag: null | 'place' | 'aim' | 'undecided' = null;
    let dragStart = { x: 0, y: 0 };
    let kbAngle = -Math.PI / 2, kbPower = 0, charging = false;
    let phase: 'aim' | 'moving' | 'cpu' | 'over' = 'aim';
    let message = '';
    let cpuGhost: null | { x: number; angle: number; power: number; t: number } = null;

    // ---------- view ----------
    let scale = 1;
    // The break alternates between boards and the breaker plays white (ECC law 29). Board 1, 3, …:
    // you (or player 1) break with white; board 2, 4, …: the computer (or player 2) does.
    let board = 1;
    const myColor = () => (board % 2 ? 'white' : 'black'); // you, or player 1
    // You always sit at the bottom; in a two-player game the player on turn does.
    const flipped = () => (mode === 'two' ? state.turn === 'black' : myColor() === 'black');
    function resize() {
      const w = canvas.clientWidth || 360;
      const dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = Math.round(w * dpr); canvas.height = Math.round(w * dpr);
      scale = (w * dpr) / (C.BOARD + FRAME * 2);
      draw();
    }
    function toBoard(e: PointerEvent) {
      const r = canvas.getBoundingClientRect();
      const s = (C.BOARD + FRAME * 2) / r.width;
      let x = (e.clientX - r.left) * s - FRAME, y = (e.clientY - r.top) * s - FRAME;
      if (flipped()) { x = C.BOARD - x; y = C.BOARD - y; }
      return { x, y };
    }

    // ---------- helpers ----------
    const human = () => phase === 'aim' && (mode === 'two' || state.turn === myColor());
    const baseY = () => C.BASE_Y[C.side(state.turn)];
    const nameOf = (c: 'white' | 'black') => (c === myColor() ? (mode === 'computer' ? L.you : L.p1) : mode === 'computer' ? L.cpu : L.p2);
    function setStriker(x: number) {
      strikerX = C.clampStrikerX(x);
    }
    function shotFromAim() {
      if (!aim) return null;
      const y = baseY();
      const dx = strikerX - aim.px, dy = y - aim.py;
      const pull = Math.hypot(dx, dy);
      return { angle: Math.atan2(dy, dx), power: Math.min(1, pull / 340) ** 1.6, ok: pull > 10 };
    }
    function statusText() {
      if (state.winner) return '';
      if (phase === 'cpu') return L.cpuThinks;
      if (human() && !C.strikerFree(state, strikerX)) return `${message ? message + ' ' : ''}${L.blocked}`;
      if (message) return message;
      const breaking = !state.broken && !state.shots;
      if (mode === 'computer') return state.turn === myColor() ? (breaking ? L.youBreak : L.yourTurn(L[state.turn])) : breaking ? L.cpuBreaks : L.cpuShoots;
      return breaking ? L.starts(nameOf(state.turn)) : L.turnOf(nameOf(state.turn), L[state.turn]);
    }
    function ui() {
      $('[data-count="white"]').textContent = String(state.pocketed.white);
      $('[data-count="black"]').textContent = String(state.pocketed.black);
      $('[data-name="white"]').textContent = nameOf('white');
      $('[data-name="black"]').textContent = nameOf('black');
      root.querySelectorAll<HTMLElement>('.cg-side').forEach((el) => el.classList.toggle('on', el.dataset.side === state.turn && !state.winner));
      $('[data-queen]').textContent = L.queen[state.queen.state as 'board'];
      root.querySelectorAll<HTMLElement>('[data-total]').forEach((el) => (el.textContent = String(C.coinsOf(state))));
      $('[data-rules]').textContent = nb(state.easy ? L.rules.easy : L.rules.full);
      $('[data-status]').textContent = nb(statusText());
      // Who begins, and so has white, stays on the board until the first shot.
      const start = $('[data-start]');
      start.hidden = state.shots > 0 || !!state.winner;
      $('[data-start-text]').textContent = nb(mode === 'computer' ? (myColor() === 'white' ? L.badgeYou : L.badgeCpu) : L.badge(nameOf('white')));
      const over = $('[data-over]');
      over.hidden = !state.winner;
      if (state.winner) {
        $('[data-over-title]').textContent = mode === 'computer' ? (state.winner === myColor() ? L.youWon : L.lost) : L.won(nameOf(state.winner));
        $('[data-over-text]').textContent = nb(`${state.reason ? L.reason[state.reason] + ' ' : ''}${L.pts(state.points)}`);
      }
    }

    // ---------- drawing ----------
    function draw() {
      const s = scale;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.setTransform(s, 0, 0, s, FRAME * s, FRAME * s);
      if (flipped()) { ctx.translate(C.BOARD, C.BOARD); ctx.rotate(Math.PI); }
      // frame
      rr(-FRAME, -FRAME, C.BOARD + FRAME * 2, C.BOARD + FRAME * 2, 26, COL.frame);
      rr(-FRAME + 8, -FRAME + 8, C.BOARD + FRAME * 2 - 16, C.BOARD + FRAME * 2 - 16, 20, COL.frame2);
      // surface
      const g = ctx.createRadialGradient(C.CENTER, C.CENTER, 60, C.CENTER, C.CENTER, C.BOARD * 0.75);
      g.addColorStop(0, COL.birch); g.addColorStop(1, COL.birch2);
      ctx.fillStyle = g; ctx.fillRect(0, 0, C.BOARD, C.BOARD);
      // pockets
      const G = C.geom(state);
      for (const [x, y] of G.pockets) circle(x, y, G.pocket, COL.navy);
      // base lines
      ctx.strokeStyle = COL.navy; ctx.lineWidth = 2.4;
      const L1 = 135, L2 = C.BOARD - 135;
      for (const [side, y0] of [['b', C.BOARD - 102], ['t', 102]] as const) {
        const y1 = side === 'b' ? y0 - 31.8 : y0 + 31.8;
        line(L1 + 15.9, y0, L2 - 15.9, y0); line(L1 + 15.9, y1, L2 - 15.9, y1);
        for (const x of [L1 + 15.9, L2 - 15.9]) { ring(x, (y0 + y1) / 2, 15.9, COL.navy, 2.4); circle(x, (y0 + y1) / 2, 11, COL.red); }
      }
      for (const [x0, side] of [[102, 'l'], [C.BOARD - 102, 'r']] as const) {
        const x1 = side === 'l' ? x0 + 31.8 : x0 - 31.8;
        line(x0, L1 + 15.9, x0, L2 - 15.9); line(x1, L1 + 15.9, x1, L2 - 15.9);
        for (const y of [L1 + 15.9, L2 - 15.9]) { ring((x0 + x1) / 2, y, 15.9, COL.navy, 2.4); circle((x0 + x1) / 2, y, 11, COL.red); }
      }
      // diagonal arrows towards the pockets
      ctx.strokeStyle = COL.navy; ctx.lineWidth = 1.6;
      for (const [sx, sy] of [[1, 1], [-1, 1], [1, -1], [-1, -1]]) {
        const ax = C.CENTER - sx * 105, ay = C.CENTER - sy * 105, bx = C.CENTER - sx * 265, by = C.CENTER - sy * 265;
        line(ax, ay, bx, by);
      }
      // centre
      ring(C.CENTER, C.CENTER, 85, COL.red, 2.4);
      ring(C.CENTER, C.CENTER, 15.9, COL.red, 1.6);
      // coins
      for (const p of state.pieces) if (p.inPlay) coin(p.x, p.y, p.r, p.color);
      // striker
      const showStriker = state.striker ?? (phase !== 'over' ? { x: cpuGhost?.x ?? strikerX, y: baseY() } : null);
      if (state.striker && state.striker.inPlay) striker(state.striker.x, state.striker.y, false);
      else if (!state.striker && showStriker && !state.winner) {
        const blocked = !C.strikerFree(state, showStriker.x);
        // aim line
        const sh = cpuGhost ? { angle: cpuGhost.angle, power: cpuGhost.power * Math.min(1, cpuGhost.t), ok: true } : aim ? shotFromAim() : charging || kbPower ? { angle: kbAngle, power: kbPower, ok: true } : null;
        if (sh && sh.power > 0) {
          const len = 180 + sh.power * 620;
          const live = sh.ok && !blocked;
          ctx.save();
          ctx.setLineDash([10, 9]); ctx.lineWidth = 3; ctx.strokeStyle = live ? COL.navy : '#9AA3B8';
          if (!cpuGhost && levelSel.value !== 'hard') {
            // Aiming guide (not on Hard): the striker up to the first coin, then where that coin goes,
            // and the next coin it would push.
            const pr = C.predictShot(state, showStriker.x, sh.angle);
            line(pr.striker.from[0], pr.striker.from[1], pr.striker.to[0], pr.striker.to[1]);
            ctx.setLineDash([]);
            if (pr.coins.length) ring(pr.striker.to[0], pr.striker.to[1], G.striker, 'rgba(14,27,61,.45)', 2);
            pr.coins.forEach((c, i) => {
              ctx.globalAlpha = live ? (i ? 0.55 : 0.95) : 0.5;
              ctx.strokeStyle = live ? COL.red : '#9AA3B8'; ctx.lineWidth = i ? 2.4 : 3.2;
              ctx.setLineDash(i ? [6, 7] : []);
              // In a packed rack the next coin touches at once, so draw at least a short arrow.
              const dx = c.to[0] - c.from[0], dy = c.to[1] - c.from[1], d = Math.hypot(dx, dy) || 1;
              const L = Math.max(d, c.piece.r + 55);
              const to = [c.from[0] + (dx / d) * L, c.from[1] + (dy / d) * L];
              line(c.from[0], c.from[1], to[0], to[1]);
              arrow(c.from, to, i ? 9 : 12);
              ring(c.piece.x, c.piece.y, c.piece.r + 3, ctx.strokeStyle as string, 2.4);
            });
            ctx.globalAlpha = 1;
          } else {
            line(showStriker.x, showStriker.y, showStriker.x + Math.cos(sh.angle) * len, showStriker.y + Math.sin(sh.angle) * len);
          }
          ctx.restore();
          // power arc
          ctx.lineWidth = 5; ctx.strokeStyle = sh.ok && !blocked ? COL.red : '#9AA3B8';
          ctx.beginPath(); ctx.arc(showStriker.x, showStriker.y, G.striker + 9, -Math.PI / 2, -Math.PI / 2 + sh.power * Math.PI * 2); ctx.stroke();
        }
        striker(showStriker.x, showStriker.y, blocked);
      }
    }
    function rr(x: number, y: number, w: number, h: number, r: number, c: string) { ctx.fillStyle = c; ctx.beginPath(); ctx.roundRect(x, y, w, h, r); ctx.fill(); }
    function circle(x: number, y: number, r: number, c: string) { ctx.fillStyle = c; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill(); }
    function ring(x: number, y: number, r: number, c: string, w: number) { if (!w) return; ctx.strokeStyle = c; ctx.lineWidth = w; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.stroke(); }
    function arrow(from: number[], to: number[], size: number) {
      const a = Math.atan2(to[1] - from[1], to[0] - from[0]);
      if (Math.hypot(to[0] - from[0], to[1] - from[1]) < size * 2) return;
      ctx.setLineDash([]);
      ctx.beginPath();
      ctx.moveTo(to[0] - Math.cos(a - 0.45) * size, to[1] - Math.sin(a - 0.45) * size);
      ctx.lineTo(to[0], to[1]);
      ctx.lineTo(to[0] - Math.cos(a + 0.45) * size, to[1] - Math.sin(a + 0.45) * size);
      ctx.stroke();
    }
    function line(a: number, b: number, c: number, d: number) { ctx.beginPath(); ctx.moveTo(a, b); ctx.lineTo(c, d); ctx.stroke(); }
    function coin(x: number, y: number, r: number, color: string) {
      circle(x + 1.6, y + 2.2, r, 'rgba(59,36,22,.28)');
      const base = color === 'white' ? COL.white : color === 'black' ? COL.black : COL.red;
      circle(x, y, r, base);
      ring(x, y, r * 0.62, color === 'white' ? 'rgba(14,27,61,.18)' : 'rgba(255,255,255,.22)', 1.6);
      ring(x, y, r - 0.8, color === 'white' ? 'rgba(14,27,61,.35)' : 'rgba(0,0,0,.35)', 1.2);
    }
    function striker(x: number, y: number, blocked: boolean) {
      const SR = C.geom(state).striker;
      circle(x + 2, y + 2.6, SR, 'rgba(59,36,22,.3)');
      circle(x, y, SR, '#F4F1EA');
      ring(x, y, SR - 1, blocked ? COL.red : COL.frame, 2.6);
      ring(x, y, SR * 0.55, blocked ? COL.red : COL.navy, 2);
      circle(x, y, 3.5, blocked ? COL.red : COL.navy);
    }

    // ---------- game flow ----------
    function shoot(angle: number, power: number) {
      if (!C.strikerFree(state, strikerX)) { message = L.blocked; ui(); draw(); return; }
      message = '';
      C.startShot(state, strikerX, angle, power);
      phase = 'moving';
      ui();
      run();
    }
    function run() {
      let last = performance.now(), acc = 0;
      const game = state; // a new game started meanwhile stops this loop
      const frame = (now: number) => {
        if (state !== game) return;
        acc += Math.min(0.05, (now - last) / 1000) * (reduceMotion ? 3 : 1);
        last = now;
        let more = true;
        while (acc >= 1 / 240 && more) { more = C.tick(state); acc -= 1 / 240; }
        draw();
        if (more) requestAnimationFrame(frame);
        else finish();
      };
      requestAnimationFrame(frame);
    }
    function finish() {
      const r = C.endShot(state);
      const key = r.msg.find((m: string) => m !== 'own' || r.msg.length === 1) ?? r.msg[0];
      message = key ? (L as any)[key] ?? '' : '';
      if (r.again && !r.foul && r.msg.includes('own') && !r.msg.includes('pending') && !r.msg.includes('covered')) message = L.own;
      phase = state.winner ? 'over' : 'aim';
      aim = null; kbPower = 0;
      setStriker(C.CENTER);
      if (!state.winner && !C.strikerFree(state, strikerX)) {
        for (let d = 10; d < 400; d += 10) { if (C.strikerFree(state, C.CENTER + d)) { setStriker(C.CENTER + d); break; } if (C.strikerFree(state, C.CENTER - d)) { setStriker(C.CENTER - d); break; } }
      }
      kbAngle = state.turn === 'white' ? -Math.PI / 2 : Math.PI / 2;
      ui(); draw();
      if (!state.winner && mode === 'computer' && state.turn !== myColor()) cpuTurn();
    }
    function cpuTurn() {
      phase = 'cpu'; ui();
      const game = state;
      setTimeout(() => {
        if (state !== game) return;
        const shot = C.chooseShot(state, state.easy ? { simple: true } : { skill: SKILL[levelSel.value] ?? 0.6 });
        // show where it plays, then shoot
        const from = strikerX, t0 = performance.now(), dur = reduceMotion ? 1 : 900;
        cpuGhost = { ...shot, t: 0 };
        const anim = (now: number) => {
          if (state !== game) return;
          const k = Math.min(1, (now - t0) / dur);
          cpuGhost!.x = from + (shot.x - from) * Math.min(1, k * 1.6);
          cpuGhost!.t = Math.max(0, (k - 0.55) / 0.45);
          draw();
          if (k < 1) requestAnimationFrame(anim);
          else { cpuGhost = null; strikerX = shot.x; phase = 'aim'; message = ''; shoot(shot.angle, shot.power); }
        };
        requestAnimationFrame(anim);
      }, 350);
    }
    function reset() {
      state = C.newGame({ mode, easy: easy() }); // white breaks
      phase = 'aim'; message = ''; aim = null; cpuGhost = null; kbPower = 0; kbAngle = -Math.PI / 2;
      setStriker(C.CENTER);
      ui(); draw();
      if (mode === 'computer' && myColor() !== 'white') cpuTurn();
    }
    const nextBoard = () => { board++; reset(); };
    const firstBoard = () => { board = 1; reset(); };

    // ---------- input ----------
    canvas.addEventListener('pointerdown', (e) => {
      if (!human()) return;
      const p = toBoard(e);
      canvas.setPointerCapture(e.pointerId);
      dragStart = p;
      message = '';
      const nearStriker = Math.hypot(p.x - strikerX, p.y - baseY()) < C.geom(state).striker * 2.2;
      drag = nearStriker ? 'undecided' : 'aim';
      if (drag === 'aim') aim = { px: p.x, py: p.y };
      draw();
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const p = toBoard(e);
      if (drag === 'undecided') {
        const dx = p.x - dragStart.x, dy = p.y - dragStart.y;
        if (Math.hypot(dx, dy) < 8) return;
        drag = Math.abs(dx) > Math.abs(dy) * 1.2 ? 'place' : 'aim';
      }
      if (drag === 'place') setStriker(strikerX + (p.x - dragStart.x)), (dragStart = p);
      else aim = { px: p.x, py: p.y };
      ui(); draw();
    });
    const up = () => {
      if (drag === 'aim') {
        const sh = shotFromAim();
        aim = null;
        if (sh && sh.ok) shoot(sh.angle, sh.power);
      }
      drag = null;
      draw();
    };
    canvas.addEventListener('pointerup', up);
    canvas.addEventListener('pointercancel', () => { drag = null; aim = null; draw(); });
    canvas.addEventListener('keydown', (e) => {
      if (!human()) return;
      const dir = flipped() ? -1 : 1;
      if (e.key === 'ArrowLeft') setStriker(strikerX - 8 * dir);
      else if (e.key === 'ArrowRight') setStriker(strikerX + 8 * dir);
      else if (e.key === 'ArrowUp') kbAngle -= 0.03 * dir;
      else if (e.key === 'ArrowDown') kbAngle += 0.03 * dir;
      else if (e.key === ' ' && !charging) {
        charging = true; kbPower = 0;
        const t0 = performance.now();
        const grow = (now: number) => { if (!charging) return; kbPower = 0.03 + ((((now - t0) / 2200) % 1) ** 1.6) * 0.97; draw(); requestAnimationFrame(grow); };
        requestAnimationFrame(grow);
      } else return;
      e.preventDefault();
      if (!kbPower) kbPower = 0.0001;
      ui(); draw();
    });
    canvas.addEventListener('keyup', (e) => {
      if (e.key === ' ' && charging) { charging = false; e.preventDefault(); shoot(kbAngle, kbPower); }
    });
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode as 'computer' | 'two';
      root.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      firstBoard();
    }));
    levelSel.addEventListener('change', firstBoard);
    $('[data-reset]').addEventListener('click', nextBoard);
    $('[data-again]').addEventListener('click', nextBoard);
    new ResizeObserver(resize).observe(canvas);
    reset();
    resize();
  }
</script>

<style>
  .cg { display: flex; flex-direction: column; gap: 12px; width: 100%; max-width: 820px; }
  @media (max-width: 599px) { .cg-stage { margin-inline: calc(-1 * var(--gutter)); } .cg-stage canvas { border-radius: 0; } }
  .cg-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cg-level { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); }
  .cg-level select { min-height: 44px; border-radius: 22px; border: 1px solid var(--chip-line); background: var(--surface); color: var(--navy); font: 600 15px var(--f-body); padding: 0 14px; }
  .cg-level select:disabled { opacity: 0.45; }
  .cg-score { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); }
  .cg-side { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; }
  .cg-side b { color: var(--navy); font-size: 16px; }
  .cg-side.on { background: var(--navy); color: #fff; }
  .cg-side.on b { color: #fff; }
  .cg-queen { font-size: 13px; text-align: center; }
  .dot { width: 14px; height: 14px; border-radius: 50%; display: inline-block; border: 1.5px solid var(--navy); }
  .dot.w { background: #FBF7EE; }
  .dot.b { background: #1D2233; }
  .cg-stage { position: relative; }
  canvas { display: block; width: 100%; aspect-ratio: 1; touch-action: none; border-radius: 14px; cursor: crosshair; }
  canvas:focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }
  .cg-over { position: absolute; inset: 22% 12%; background: rgba(14, 27, 61, 0.94); color: #fff; border-radius: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center; padding: 20px; }
  .cg-over[hidden] { display: none; }
  .cg-start { position: absolute; left: 50%; top: 60%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 10px; max-width: 86%; white-space: nowrap; padding: 10px 18px; border-radius: 999px; background: rgba(14, 27, 61, 0.92); color: #fff; font: 700 17px/1.25 var(--f-body); text-align: center; box-shadow: 0 6px 20px rgba(14, 27, 61, 0.25); pointer-events: none; }
  .cg-start[hidden] { display: none; }
  .cg-start .dot { flex: none; width: 16px; height: 16px; border: 2px solid #fff; }
  @media (max-width: 599px) { .cg-start { font-size: 14px; padding: 8px 14px; } }
  .cg-over strong { font: 800 32px/1.1 var(--f-head); }
  .cg-status { min-height: 48px; font-weight: 600; color: var(--navy); }
  .cg-rules { margin: 0; color: var(--muted); }
  .cg-foot { display: flex; gap: 12px; }
  @media (hover: none) { .cg-keys { display: none; } }
</style>
