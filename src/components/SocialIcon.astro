---
// Brand icons for the links in navigation.social (top bar, Více page).
interface Props { name: string }
const { name } = Astro.props;
---
{name === 'facebook' && <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1877F2"/><path fill="#fff" d="M13.4 19.5v-6.2h2.1l.3-2.5h-2.4V9.3c0-.7.2-1.2 1.2-1.2h1.3V5.9c-.2 0-1-.1-1.9-.1-1.9 0-3.2 1.2-3.2 3.3v1.8H8.7v2.5h2.1v6.2z"/></svg>}
{name === 'youtube' && <svg viewBox="0 0 28 20" width="30" height="22" aria-hidden="true"><rect width="28" height="20" rx="5" fill="#FF0000"/><path fill="#fff" d="M11.2 6v8l7-4z"/></svg>}
