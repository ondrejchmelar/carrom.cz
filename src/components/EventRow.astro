---
// One calendar row. `eds` holds one edition, or several held back to back at the same place
// (e.g. juniors on Friday, singles on Saturday, doubles on Sunday): they share one row under the main
// event's name and link, with the whole date range (Ondrej 2026-11-28: juniors are part of the Jarní turnaj).
import { editionName, editionUrl, dayOfMonth, monthShort, dateShort, weekday, type Lang } from '../lib/site';
interface Props { ed?: any; eds?: any[]; hot?: boolean; lang?: Lang }
const { ed, hot = false, lang = 'cs' } = Astro.props;
const eds: any[] = Astro.props.eds ?? [ed];
const CAT: Record<string, string> = lang === 'en'
  ? { mcr: 'Championship', league: 'League', junior: 'Juniors', abroad: 'Abroad', other: 'Tournament' }
  : { mcr: 'Turnaj MČR', league: 'Liga', junior: 'Junioři', abroad: 'Zahraničí', other: 'Turnaj' };
const start = eds.map((e) => e.start_date).sort()[0];
const end = eds.map((e) => e.end_date ?? e.start_date).sort().at(-1);
const multi = end && end !== start;
const sameMonth = multi && start.slice(0, 7) === end.slice(0, 7);
const badgeDay = multi && sameMonth ? `${dayOfMonth(start)}–${dayOfMonth(end)}` : `${dayOfMonth(start)}`;
const when = !multi
  ? `${weekday(start, lang)} ${dateShort(start, true, lang)}`
  : lang === 'en'
    ? `${weekday(start, lang)} ${dateShort(start, !sameMonth && start.slice(0, 4) !== end.slice(0, 4), lang)} – ${weekday(end, lang)} ${dateShort(end, true, lang)}`
    : `${weekday(start, lang).toLowerCase()} ${sameMonth ? `${dayOfMonth(start)}.` : dateShort(start, start.slice(0, 4) !== end.slice(0, 4), lang)} – ${weekday(end, lang).toLowerCase()} ${dateShort(end, true, lang)}`;
const whenCap = when.charAt(0).toUpperCase() + when.slice(1);
const main = eds.find((e) => e.competition.category === 'mcr') ?? eds.find((e) => e.competition.category !== 'junior') ?? eds[0];
const place = main.venue?.city ?? main.venue?.name;
const cats = CAT[main.competition.category] ?? (lang === 'en' ? 'Event' : 'Akce');
const open = main.status === 'registration_open' && main.signup_url;
---
<a class:list={['event', { hot }]} href={editionUrl(main, lang)}>
  <span class:list={['date-badge', { hot, range: multi && sameMonth }]}><b>{badgeDay}</b><span>{monthShort(start, lang)}</span></span>
  <span class="what">
    <span class="eyebrow">{cats}</span>
    <strong>{editionName(main, lang)}</strong>
    <span class="small">{whenCap}{place ? ` · ${place}` : ''}</span>
  </span>
  {open && <span class="btn btn-red cta">{lang === 'en' ? 'Sign up' : 'Přihlásit se'}</span>}
</a>
<style>
  .date-badge.range b { font-size: 22px; letter-spacing: -0.02em; }
</style>
