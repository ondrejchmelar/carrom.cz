---
import { model } from '../lib/data';
import { t, pageUrl, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = model();
const s = m.settings.site ?? {};
---
<footer class="site-footer">
  <div class="wrap inner">
    <div class="who">
      <strong>{t(s.org, lang)}</strong>
      <a href={`mailto:${s.email}`}>{s.email}</a>
    </div>
    <nav aria-label={lang === 'en' ? 'Footer' : 'Patička'}>
      {(m.navigation.footer ?? []).map((item: any) => <a href={pageUrl(item, lang)}>{t(item.label, lang)}</a>)}
    </nav>
  </div>
</footer>
<style>
  .site-footer { background: var(--navy); color: var(--on-navy-muted); margin-top: 0; padding-bottom: var(--tabbar-h); }
  .inner { padding-block: 24px; display: flex; flex-direction: column; gap: 12px; font-size: 15px; }
  .who { display: flex; flex-direction: column; gap: 2px; }
  .who strong { color: #fff; }
  a { color: var(--on-navy-muted); }
  a:hover { color: #fff; }
  nav { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  nav a { min-height: 44px; display: inline-flex; align-items: center; }
  @media (min-width: 1100px) {
    .site-footer { padding-bottom: 0; }
    .inner { flex-direction: row; justify-content: space-between; align-items: center; padding-block: 28px; font-size: 16px; }
    .who { flex-direction: row; gap: 8px; }
    .who strong::after { content: ' ·'; font-weight: 400; color: var(--on-navy-muted); }
  }
</style>
