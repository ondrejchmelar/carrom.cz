---
import { model } from '../lib/data';
import { t, pageUrl, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = model();
const s = m.settings.site ?? {};
---
<footer class="site-footer">
  <div class="wrap inner">
    <div class="who">
      <strong>{t(s.org, lang)}</strong>
      <a href={`mailto:${s.email}`}>{s.email}</a>
    </div>
    <nav aria-label={lang === 'en' ? 'Footer' : 'Patička'}>
      {(m.navigation.footer ?? []).map((item: any) => <a href={pageUrl(item, lang)}>{t(item.label, lang)}</a>)}
    </nav>
  </div>
</footer>
<style>
  /* Phones and tablets (bottom tab bar) get no footer, only a spacer under the fixed bar; its links are on the Více page (Ondrej 2026-11-28). */
  .site-footer { color: var(--on-navy-muted); height: var(--tabbar-h); }
  .inner { display: none; }
  a { color: var(--on-navy-muted); }
  a:hover { color: #fff; }
  .who strong { color: #fff; }
  @media (min-width: 1100px) {
    .site-footer { height: auto; background: var(--navy); }
    .inner { display: flex; justify-content: space-between; align-items: center; padding-block: 28px; font-size: 16px; }
    .who { display: flex; gap: 8px; }
    .who strong::after { content: ' ·'; font-weight: 400; color: var(--on-navy-muted); }
    nav { display: flex; flex-wrap: wrap; gap: 0 16px; }
    nav a { min-height: 44px; display: inline-flex; align-items: center; }
  }
</style>
