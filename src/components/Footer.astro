---
import { model } from '../lib/data';
import { t, pageUrl, type Lang } from '../lib/site';
import SocialIcon from './SocialIcon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = model();
const s = m.settings.site ?? {};
---
<footer class="site-footer">
  <div class="wrap inner">
    <div class="who">
      <strong>{t(s.org, lang)}</strong>
      <a href={`mailto:${s.email}`}>{s.email}</a>
    </div>
    <nav aria-label={lang === 'en' ? 'Footer' : 'Patička'}>
      {(m.navigation.footer ?? []).map((item: any) => <a href={pageUrl(item, lang)}>{t(item.label, lang)}</a>)}
      {(m.navigation.social ?? []).map((sx: any) => (
        <a class="social" href={sx.url} rel="noopener" aria-label={t(sx.label, lang)} title={t(sx.label, lang)}><SocialIcon name={sx.icon} /></a>
      ))}
    </nav>
  </div>
</footer>
<style>
  .site-footer { background: var(--navy); color: var(--on-navy-muted); margin-top: 0; padding-bottom: var(--tabbar-h); }
  .inner { padding-block: 16px; display: flex; flex-direction: column; gap: 6px; font-size: 14px; }
  .who { display: flex; flex-wrap: wrap; gap: 0 8px; }
  .who strong { color: #fff; }
  a { color: var(--on-navy-muted); }
  a:hover { color: #fff; }
  nav { display: flex; flex-wrap: wrap; gap: 0 12px; }
  nav a { min-height: 32px; display: inline-flex; align-items: center; }
  nav .social { display: none; min-width: 32px; justify-content: center; }
  /* Only where the top bar has no room for them (Ondrej 2026-11-28). */
  @media (min-width: 1100px) and (max-width: 1199px) { nav .social { display: inline-flex; } }
  nav .social :global(svg) { width: 24px; height: auto; }
  nav .social + .social { margin-left: -8px; }
  @media (min-width: 1100px) {
    .site-footer { padding-bottom: 0; }
    .inner { flex-direction: row; justify-content: space-between; align-items: center; padding-block: 28px; font-size: 16px; }
    nav { gap: 0 16px; }
    nav a { min-height: 44px; }
    .who strong::after { content: ' ·'; font-weight: 400; color: var(--on-navy-muted); }
  }
</style>
