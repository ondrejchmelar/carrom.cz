---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabBar from '../components/TabBar.astro';
import { model } from '../lib/data';
import { url, lp, csPath, type Lang } from '../lib/site';
interface Props { title?: string; description?: string; lang?: Lang; current?: string; alt?: string; noindex?: boolean }
const { title, description, lang = 'cs', current, alt, noindex } = Astro.props;
const m = model();
// Link to the same page in the other language (every Czech page has an English twin under /en/).
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.startsWith(BASE) ? Astro.url.pathname.slice(BASE.length) || '/' : Astro.url.pathname;
const altHref = alt ?? url(lang === 'en' ? csPath(here) : lp(here, 'en'));
const siteName = lang === 'en' ? 'carrom.cz · Czech Carrom Association' : 'carrom.cz · Česká carromová asociace';
const fullTitle = title ? `${title} · carrom.cz` : siteName;
const desc = description ?? (lang === 'en' ? 'Carrom in the Czech Republic: tournaments, leagues, results and where to play.' : 'Carrom v Česku: turnaje, ligy, výsledky a kde si zahrát.');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {(noindex || m.settings.preview_banner) && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <link rel="icon" href={url('/brand/emblem.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#0E1B3D" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(url('/brand/icon-512.png'), Astro.site).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600;700&display=swap" />
    <link rel="alternate" hreflang={lang === 'en' ? 'cs' : 'en'} href={altHref} />
    <link rel="alternate" type="text/calendar" title="Kalendář ČCA" href={url('/kalendar.ics')} />
  </head>
  <body>
    {m.settings.preview_banner && (
      <div class="preview-banner">{lang === 'en' ? 'Test version of the new site. Some data are samples.' : 'Testovací verze nového webu. Část dat je ukázková.'}</div>
    )}
    <Header lang={lang} current={current} alt={altHref} />
    <main id={lang === 'en' ? 'content' : 'obsah'}>
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      // External links (Facebook, YouTube, galleries, SoL, federations…) open in a new tab.
      document.querySelectorAll('a[href^="http"]').forEach(function (a) {
        if (a.host !== location.host && !a.target) { a.target = '_blank'; a.rel = ((a.rel || '') + ' noopener').trim(); }
      });
    </script>
    <TabBar lang={lang} current={current} />
  </body>
</html>
