---
import Base from '../../../layouts/Base.astro';
import ResultsTable from '../../../components/ResultsTable.astro';
import PaymentNote from '../../../components/PaymentNote.astro';
import fs from 'node:fs';
import { model } from '../../../lib/data';
import { url, t, nbsp, editionName, dateLong, weekday, dateShort } from '../../../lib/site';
export function getStaticPaths() {
  const m = model();
  return Object.values(m.editions).filter((e: any) => e.competition.kind !== 'league').map((e: any) => ({ params: { code: e.code, year: String(e.year) }, props: { id: e.id } }));
}
const m = model();
const ed = m.editions[(Astro.props as any).id];
// Only documents whose file is already in public/ (the rest arrive with the import).
const docs = m.documents.filter((d: any) => d.edition === ed.id && fs.existsSync(`public${t(d.file)}`));
const today = new Date().toISOString().slice(0, 10);
const signupOpen = ed.status === 'registration_open' && ed.signup_url && (!ed.signup_deadline || ed.signup_deadline >= today);
const upcoming = ed.status !== 'finished';
// Optional YouTube link to the final: youtu.be/<id>, youtube.com/watch?v=<id>, /live/<id>, /shorts/<id>
const videoId = (() => {
  const u = ed.final_video;
  if (!u) return null;
  const m = /(?:youtu\.be\/|[?&]v=|\/(?:embed|live|shorts)\/)([A-Za-z0-9_-]{11})/.exec(String(u));
  return m ? m[1] : null;
})();
---
<Base title={editionName(ed)} current="vysledky">
  <div class="wrap page">
    <div class="page-head">
      <a class="small" href={url(`/vysledky/${ed.code}/`)}>{t(ed.competition.name)}</a>
      <h1>{editionName(ed)}</h1>
      <span class="eyebrow">{`${weekday(ed.start_date)} ${dateLong(ed.start_date)}`}{ed.venue?.name ? ` · ${ed.venue.name}` : ''}</span>
      {ed.report && <p class="lede">{nbsp(t(ed.report))}</p>}
    </div>
    {upcoming && (
      <section class="section">
        <div class="card-navy info">
          {ed.schedule && <p>{t(ed.schedule)}</p>}
          {ed.signup_deadline && <p class="muted">Přihlášky do {dateShort(ed.signup_deadline)}</p>}
          <div class="btn-row">
            {signupOpen && <a class="btn btn-red" href={ed.signup_url} rel="noopener">Přihlásit se</a>}
            {docs.map((d: any) => <a class="btn btn-ghost-light" href={url(t(d.file))}>{t(d.title)}</a>)}
          </div>
          {signupOpen && <PaymentNote />}
        </div>
      </section>
    )}
    {!upcoming && docs.length > 0 && (
      <div class="btn-row">{docs.map((d: any) => <a class="btn btn-ghost" href={url(t(d.file))}>{t(d.title)}</a>)}</div>
    )}
    {!upcoming && (
      <section class="section">
        <h2>Konečné pořadí</h2>
        <ResultsTable ed={ed} />
        {ed.sol_lit_url && <a class="btn btn-ghost" href={ed.sol_lit_url} rel="noopener">Podrobné výsledky v SoL lit</a>}
      </section>
    )}
    {videoId && (
      <section class="section">
        <h2>Finále na videu</h2>
        <div class="video">
          <iframe src={`https://www.youtube-nocookie.com/embed/${videoId}`} title={`Finále: ${editionName(ed)}`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </section>
    )}
  </div>
</Base>
<style>
  .info { max-width: 720px; }
  .video { position: relative; width: 100%; max-width: 880px; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: var(--navy); }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
