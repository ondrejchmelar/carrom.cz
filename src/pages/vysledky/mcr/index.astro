---
import Base from '../../../layouts/Base.astro';
import { model } from '../../../lib/data';
import { url, t, plainName } from '../../../lib/site';
const m = model();
const list = Object.values(m.rankings).sort((a: any, b: any) => b.year - a.year) as any[];
---
<Base title="Mistrovství ČR" current="vysledky">
  <div class="wrap page">
    <div class="page-head"><a class="small" href={url('/vysledky/')}>Výsledky</a><h1>Mistrovství ČR</h1>
      <p class="lede">Seriál tří turnajů: Jarní turnaj, Druhý turnaj a Carrom Open Cup. Počítají se dva nejlepší.</p></div>
    <div class="row-list">
      {list.map((r) => (
        <a href={url(`/vysledky/mcr/${r.year}/`)}>
          <span class="when">{r.year}</span>
          <span class="what"><strong>{t(r.name)}</strong></span>
          <span class="tail">{r.table.rows[0] ? `Mistr ${plainName(m.players[r.table.rows[0].player], r.table.rows[0].player)}` : 'Připravujeme'}</span>
        </a>
      ))}
    </div>
  </div>
</Base>
