---
import Base from '../../../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { url } from '../../../lib/site';
const page = await getEntry('pages', 'hra-carrom.en');
const { Content } = page ? await render(page) : { Content: null };
---
<Base lang="en" title={page?.data.title} current="hra-carrom" alt={url('/hra-carrom/')}>
  <div class="wrap page">
    <h1>{page?.data.title}</h1>
    <div class="prose">{Content && <Content />}</div>
  </div>
</Base>
