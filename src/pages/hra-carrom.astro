---
import Base from '../layouts/Base.astro';
import CarromGame from '../components/CarromGame.astro';
import { getEntry, render } from 'astro:content';
import { url, nbsp } from '../lib/site';
const page = await getEntry('pages', 'hra-carrom.cs');
const { Content } = page ? await render(page) : { Content: null };
---
<Base title="Hra carrom" description={page?.data.description} current="hra-carrom" alt={url('/en/the-game/')}>
  <div class="wrap page">
    <div class="intro">
      <div class="page-head">
        <span class="eyebrow">Kulečník na prsty</span>
        <h1>{page?.data.title ?? 'Hra carrom'}</h1>
        <div class="prose">{Content && <Content />}</div>
        <div class="btn-row">
          <a class="btn btn-red" href={url('/ligy/')}>Kde si zahrát naživo</a>
        </div>
      </div>
      <div id="hra" class="game">
        <h2 class="game-title">Zahraj si</h2>
        <CarromGame lang="cs" />
      </div>
    </div>
  </div>
</Base>
<style>
  .intro { display: grid; gap: 32px; }
  .game { display: flex; flex-direction: column; gap: 12px; max-width: 820px; scroll-margin-top: 16px; }
  @media (min-width: 960px) { .intro { grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 56px; align-items: start; } }
</style>
