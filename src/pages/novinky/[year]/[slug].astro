---
import Base from '../../../layouts/Base.astro';
import ResultsTable from '../../../components/ResultsTable.astro';
import { render } from 'astro:content';
import { articles } from '../../../lib/articles';
import { model } from '../../../lib/data';
import { url, dateLong, nbsp, editionName } from '../../../lib/site';
export async function getStaticPaths() {
  const list = await articles('cs');
  return list.map((a) => ({ params: { year: String(a.year), slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a.cs);
const m = model();
const ed = a.cs.data.edition ? m.editions[a.cs.data.edition] : null;
---
<Base title={a.cs.data.title} description={a.cs.data.perex} current="novinky">
  <article class="wrap page">
    <div class="page-head">
      <a class="small" href={url(`/novinky/${a.year}/`)}>Zprávy {a.year}</a>
      <h1>{a.cs.data.title}</h1>
      <span class="eyebrow">{dateLong(a.date)}</span>
      {a.cs.data.perex && <p class="lede">{nbsp(a.cs.data.perex)}</p>}
    </div>
    {a.cs.data.cover && <img class="cover" src={url(a.cs.data.cover)} alt="" />}
    <div class="prose"><Content /></div>
    {ed && (
      <section class="section">
        <div class="section-head"><h2>Výsledky: {editionName(ed)}</h2><a href={url(`/vysledky/${ed.code}/${ed.year}/`)}>Detail turnaje</a></div>
        <ResultsTable ed={ed} />
      </section>
    )}
  </article>
</Base>
<style>.cover { width: 100%; max-width: 880px; border-radius: 16px; }</style>
