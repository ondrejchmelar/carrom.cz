---
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/site';
import Board from '../components/Board.astro';
import Icon from '../components/Icon.astro';
import { model } from '../lib/data';
import { t, L, tr, nbsp, editionName, dateShort, weekday } from '../lib/site';
interface Props { lang?: Lang }
const { lang = 'cs' } = Astro.props;
const m = model();
const h = m.home;
const clubs = (h.where_to_play ?? []).map((id: string) => m.clubs.find((c: any) => c.id === id)).filter(Boolean);
const next = m.nextTournament;
const clubHref = (c: any) => (c.link?.competition ? L(`/vysledky/${c.link.competition}/`, lang) : L(`/ligy/#${c.id}`, lang));
---
<Base lang={lang} current="domu">
  <section class="wrap hero">
    <div class="hero-text">
      <h1>{t(h.hero?.title, lang)}</h1>
      <p class="hero-p">{nbsp(t(h.hero?.text, lang), lang)}</p>
      <div class="btn-row stack">
        <a class="btn btn-red" href={L('/ligy/', lang)}>{tr(lang, 'Kde si zahrát', 'Where to play')}</a>
        <a class="btn btn-ghost" href={L('/hra-carrom/', lang)}>{tr(lang, 'Pravidla za dvě minuty', 'The rules in two minutes')}</a>
      </div>
    </div>
    <div class="hero-board">
      <Board class="board" />
      <a class="btn btn-navy play" href={L('/hra-carrom/', lang) + (lang === 'en' ? '#play' : '#hra')}><Icon name="play" size={16} />{t(h.hero?.play_button, lang)}</a>
    </div>
  </section>

  <section class="how">
    <div class="wrap section">
      <h2>{tr(lang, 'Jak se hraje', 'How to play')}</h2>
      <ol class="steps">
        {(h.how_to_play ?? []).map((s: any, i: number) => (
          <li><span class={`n n${i + 1}`}>{i + 1}</span><span><strong>{t(s.title, lang)}</strong><span class="muted">{nbsp(t(s.text, lang), lang)}</span></span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap section where">
    <div class="section-head"><h2>{tr(lang, 'Kde hrát', 'Where to play')}</h2><a href={L('/ligy/', lang)}>{tr(lang, 'Všechny ligy a kluby', 'All leagues and clubs')}</a></div>
    <div class="grid clubs">
      {clubs.map((c: any) => (
        <a class="card" href={clubHref(c)}>
          <span class="eyebrow">{c.area}</span>
          <strong class="club-name">{c.name}</strong>
          <span class="small">{nbsp(t(c.summary, lang), lang)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap duo">
    {next && (
      <div class="card-navy nextbox">
        <div class="nb-text">
          <span class="eyebrow">{`${weekday(next.start_date, lang)} ${dateShort(next.start_date, true, lang)} · ${next.venue?.city ?? ''}`}</span>
          <strong class="nb-name">{editionName(next, lang)}</strong>
        </div>
        <a class="btn btn-red" href={next.status === 'registration_open' && next.signup_url ? next.signup_url : L(`/vysledky/${next.code}/${next.year}/`, lang)}>
          {next.status === 'registration_open' ? tr(lang, 'Přihláška', 'Sign up') : tr(lang, 'Více o turnaji', 'About the tournament')}
        </a>
      </div>
    )}
    <a class="card returning" href={L('/novinky/', lang)}>
      <strong class="ret-title">{t(h.returning?.title, lang)}</strong>
      <span class="small">{nbsp(t(h.returning?.text, lang), lang)}</span>
      <span class="ret-link">{tr(lang, 'Přejít na Novinky', 'Go to News')} <Icon name="chevron" size={16} /></span>
    </a>
  </section>
  <div style="height: 40px"></div>
</Base>

<style>
  .hero { display: flex; flex-direction: column-reverse; gap: 18px; padding-top: 16px; }
  .hero-text { display: flex; flex-direction: column; gap: 18px; }
  .hero h1 { font-size: 52px; line-height: 0.95; letter-spacing: -0.03em; }
  .hero-p { font-size: 17px; line-height: 1.5; max-width: 560px; }
  .stack { flex-direction: column; }
  .hero-board { position: relative; width: 100%; max-width: 480px; margin-inline: auto; display: flex; flex-direction: column; align-items: center; }
  .board { width: 100%; height: auto; display: block; }
  .play { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); box-shadow: 0 6px 18px rgba(14, 27, 61, 0.35); }
  .how { background: #fff; margin-top: 40px; }
  .how .section { padding-block: 32px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .steps li { display: flex; gap: 14px; align-items: flex-start; }
  .steps li > span:last-child { display: flex; flex-direction: column; gap: 4px; }
  .steps strong { font-size: 17px; }
  .n { flex: 0 0 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; }
  .n1 { background: var(--cream); border: 1.5px solid var(--navy); }
  .n2 { background: var(--navy); color: var(--cream); }
  .n3 { background: var(--red); color: #fff; }
  .where { margin-top: 40px; }
  .club-name { font-size: 18px; }
  .duo { margin-top: 40px; display: grid; gap: 14px; }
  .nextbox { gap: 14px; }
  .nb-name { font-family: var(--f-head); font-size: 26px; line-height: 1.05; }
  .nb-text { display: flex; flex-direction: column; gap: 8px; }
  .nextbox .btn { align-self: flex-start; }
  .ret-title { font-size: 18px; }
  .ret-link { color: var(--red); font-weight: 700; display: inline-flex; align-items: center; gap: 4px; }
  @media (min-width: 960px) {
    .hero { display: grid; grid-template-columns: minmax(0, 1fr) 480px; gap: 72px; align-items: center; padding-block: 48px 56px; }
    .hero h1 { font-size: 104px; line-height: 0.9; letter-spacing: -0.04em; }
    .hero-p { font-size: 20px; }
    .stack { flex-direction: row; }
    .hero-board { gap: 16px; }
    .play { position: static; transform: none; box-shadow: none; }
    .how { margin-top: 0; }
    .how .section { padding-block: 48px; gap: 28px; }
    .how h2, .where h2 { font-size: 40px; }
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
    .steps li { flex-direction: column; gap: 10px; }
    .steps strong { font-size: 20px; }
    .n { flex-basis: 48px; width: 48px; height: 48px; font-size: 18px; }
    .where { margin-top: 48px; }
    .clubs { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
    .clubs .card { padding: 20px; border-radius: 18px; }
    .club-name { font-size: 20px; }
    .duo { margin-top: 48px; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 16px; }
    .nextbox { flex-direction: row; align-items: center; justify-content: space-between; padding: 32px 40px; border-radius: 24px; }
    .nb-name { font-size: 36px; }
    .nextbox .btn { align-self: center; }
    .returning { padding: 28px; border-radius: 24px; justify-content: center; gap: 8px; }
    .ret-title { font-family: var(--f-head); font-size: 28px; font-weight: 800; }
  }
</style>
