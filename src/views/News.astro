---
// Novinky = what is coming (full calendar, phone calendars) and what happened (stories, archive).
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import Countdown from '../components/Countdown.astro';
import Icon from '../components/Icon.astro';
import { model } from '../lib/data';
import { articles } from '../lib/articles';
import { L, tr, nbsp, dateShort, monthTitle, type Lang } from '../lib/site';
interface Props { lang?: Lang }
const { lang = 'cs' } = Astro.props;
const m = model();
const today = new Date().toISOString().slice(0, 10);
const upcoming = m.editionList.filter((e: any) => e.start_date && (e.end_date ?? e.start_date) >= today);
const byMonth = new Map<string, any[]>();
for (const e of upcoming) {
  const k = e.start_date.slice(0, 7);
  byMonth.set(k, [...(byMonth.get(k) ?? []), e]);
}
const cats = [
  ['all', 'Vše', 'All'], ['mcr', 'Turnaje MČR', 'Championship'], ['league', 'Ligy', 'Leagues'], ['junior', 'Junioři', 'Juniors'], ['abroad', 'Zahraničí', 'Abroad'],
];
const nextId = m.nextTournament?.id;
const news = await articles(lang);
const latest = news.slice(0, 6);
const years = [...new Set(news.map((a) => a.year))].sort((a, b) => b - a);
---
<Base title={tr(lang, 'Novinky', 'News')} lang={lang} current="novinky">
  <div class="wrap page">
    <div class="page-head">
      <h1>{tr(lang, 'Novinky', 'News')}</h1>
      <p class="lede">{tr(lang, 'Co se chystá a co se stalo: kalendář akcí a zprávy z\u00a0turnajů a lig.', 'What is coming and what happened: the event calendar and stories from tournaments and leagues.')}</p>
    </div>
    <section class="section stories">
      <h2>{tr(lang, 'Zprávy', 'Stories')}</h2>
      {lang === 'en' && <p class="small">{'Most stories are written in Czech. Those marked “in Czech” have no English version yet.'}</p>}
      {latest.length === 0 && <p class="muted">{tr(lang, 'Zatím žádné zprávy.', 'No stories yet.')}</p>}
      <div class="grid news">
        {latest.map((a) => (
          <a class="card" href={L(`/novinky/${a.year}/${a.slug}/`, lang)}>
            <span class="eyebrow">{dateShort(a.date, true, lang)}{a.czechOnly ? ' · in Czech' : ''}</span>
            <strong class="news-title">{a.entry.data.title}</strong>
            {a.entry.data.perex && <span class="small">{nbsp(a.entry.data.perex, a.czechOnly ? 'cs' : lang)}</span>}
          </a>
        ))}
      </div>
    </section>
    <div class="layout">
      <section class="main" id="kalendar" aria-labelledby="kal-h">
        <div class="cal-head">
          <h2 id="kal-h">{tr(lang, 'Kalendář akcí', 'Calendar')}</h2>
          <div class="chips" role="group" aria-label={tr(lang, 'Filtr akcí', 'Filter events')}>
            {cats.map(([k, label, en], i) => <button type="button" class="chip" data-filter={k} aria-pressed={i === 0 ? 'true' : 'false'}>{lang === 'en' ? en : label}</button>)}
          </div>
        </div>
        {byMonth.size === 0 && <p class="muted">{tr(lang, 'Žádné další akce zatím nejsou v kalendáři.', 'No upcoming events in the calendar yet.')}</p>}
        {[...byMonth.entries()].map(([k, list]) => (
          <section class="month" data-month>
            <h3 class="month-title">{monthTitle(`${k}-01`, lang)}</h3>
            {list.map((e: any) => <div data-cat={e.competition.category}><EventRow ed={e} hot={e.id === nextId} lang={lang} /></div>)}
          </section>
        ))}
        <p class="small">{tr(lang, 'Pořádáte turnaj, veřejné hraní nebo ukázku carromu? Zapíšeme je do kalendáře, napište na', 'Organising a tournament, open play or a carrom demo? We add it to the calendar, write to')} <a class="more" href={`mailto:${m.settings.site?.email}`}>{m.settings.site?.email}</a>.</p>
        <p class="small"><a class="more" href={L('/vysledky/', lang)}>{tr(lang, 'Co už letos proběhlo, najdete ve Výsledcích →', 'Past events are under Results →')}</a></p>
      </section>
      <aside class="side">
        <Countdown compact lang={lang} />
        <div class="card pad">
          <strong class="side-title">{tr(lang, 'Mějte akce v telefonu', 'Events on your phone')}</strong>
          <span class="small">{tr(lang, 'Odebírejte sdílené kalendáře ČCA v\u00a0Google, Apple nebo Outlook kalendáři. Nové akce se objeví samy.', 'Subscribe to the association calendars in Google, Apple or Outlook. New events appear on their own.')}</span>
          <ul class="cals">
            {(m.settings.calendars ?? []).map((c: any) => (
              <li>
                <span class="cal-name"><Icon name="calplus" size={18} />{lang === 'en' ? c.en : c.cs}</span>
                <span class="cal-links">
                  <a href={`https://calendar.google.com/calendar/u/0/r?cid=${encodeURIComponent(c.id)}`} target="_blank" rel="noopener">Google</a>
                  <a href={`webcal://calendar.google.com/calendar/ical/${encodeURIComponent(c.id)}/public/basic.ics`}>{tr(lang, 'Apple / Outlook', 'Apple / Outlook')}</a>
                  <a href={`https://calendar.google.com/calendar/embed?src=${encodeURIComponent(c.id)}&ctz=Europe%2FPrague`} target="_blank" rel="noopener">{tr(lang, 'Zobrazit', 'View')}</a>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
    <section class="section">
      <h2>{tr(lang, 'Archiv zpráv', 'News archive')}</h2>
      <p class="muted">{tr(lang, 'Všechny zprávy ze starého webu, od roku 2006.', 'All stories from the old site, since 2006 (in Czech).')}</p>
      <div class="chips">{years.map((y) => <a class="chip" href={L(`/novinky/${y}/`, lang)}>{y}</a>)}</div>
    </section>
  </div>
</Base>
<style>
  .layout { display: flex; flex-direction: column; gap: 32px; }
  .main { display: flex; flex-direction: column; gap: 28px; }
  .cal-head { display: flex; flex-direction: column; gap: 14px; }
  .more { color: var(--red); font-weight: 600; }
  .news { gap: 12px; }
  .news-title { font-size: 18px; }
  .month { display: flex; flex-direction: column; gap: 10px; }
  .month-title { font-family: var(--f-body); font-size: 14px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .side { display: flex; flex-direction: column; gap: 16px; }
  .pad { padding: 22px; gap: 12px; border-radius: 18px; }
  .side-title { font-size: 18px; }
  .cals { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .cals li { display: flex; flex-direction: column; gap: 4px; padding: 10px 0; border-top: 1px solid #EEF0F5; }
  .cal-name { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--navy); }
  .cal-links { display: flex; flex-wrap: wrap; gap: 4px 14px; padding-left: 26px; font-size: 14px; }
  .cal-links a { color: var(--red); font-weight: 600; }
  [hidden] { display: none !important; }
  @media (min-width: 960px) {
    .cal-head { flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; }
    .news { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 48px; align-items: start; }
  }
</style>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-cat]').forEach((el) => { el.hidden = f !== 'all' && el.dataset.cat !== f; });
    document.querySelectorAll<HTMLElement>('[data-month]').forEach((sec) => {
      sec.hidden = ![...sec.querySelectorAll<HTMLElement>('[data-cat]')].some((x) => !x.hidden);
    });
  }));
</script>
