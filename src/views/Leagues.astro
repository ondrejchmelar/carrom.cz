---
import Base from '../layouts/Base.astro';
import { model } from '../lib/data';
import { L, t, tr, nbsp, dateShort, type Lang } from '../lib/site';
interface Props { lang?: Lang }
const { lang = 'cs' } = Astro.props;
const m = model();
const clubs = m.clubs;
const main = clubs[0];
const rest = clubs.slice(1);
const seasonOf = (code: string) => m.editionList.filter((e: any) => e.code === code).at(-1);
const mainSeason = main?.league ? seasonOf(main.league) : null;
---
<Base title={tr(lang, 'Ligy a kde si zahrát', 'Leagues and where to play')} lang={lang} current="ligy">
  <div class="wrap page">
    <div class="page-head">
      <h1>{tr(lang, 'Ligy a kde si zahrát', 'Leagues and where to play')}</h1>
      <p class="lede">{tr(lang, 'Carrom se nejlíp naučíš u desky s ostatními. Do lig se může přihlásit každý, nováčky rádi uvidíme.', 'The best way to learn carrom is at the board with others. Anyone can join a league, and newcomers are very welcome. Most players speak English too.')}</p>
    </div>
    {main && (
      <section class="card-navy feature" id={main.id}>
        <span class="eyebrow">{main.area}{mainSeason?.start_date ? ` · ${tr(lang, 'od', 'from')} ${dateShort(mainSeason.start_date, false, lang)}` : ''}</span>
        <h2>{main.name}</h2>
        <p class="muted">{nbsp(t(main.description ?? main.summary, lang), lang)}</p>
        <dl class="facts">
          {main.venue && <div><dt>{main.venue.name}</dt><dd>{main.venue.address}</dd></div>}
          {main.email && <div><dt><a href={`mailto:${main.email}`}>{main.email}</a></dt><dd>{tr(lang, 'Dotazy a přihlášky', 'Questions and sign-up')}</dd></div>}
        </dl>
        <div class="btn-row">
          {mainSeason && <a class="btn btn-red" href={L(`/ligy/${mainSeason.code}/${mainSeason.year}/`, lang)}>{tr(lang, 'Tabulka a playoff', 'Table and playoff')} {mainSeason.year}</a>}
          {mainSeason?.links?.evening_signup_url && <a class="btn btn-ghost-light" href={mainSeason.links.evening_signup_url}>{tr(lang, 'Rezervační tabulka', 'Evening sign-up sheet')}</a>}
        </div>
      </section>
    )}
    <section class="section">
      <h2>{tr(lang, 'Další ligy a kluby', 'More leagues and clubs')}</h2>
      <div class="grid more">
        {rest.map((c: any) => {
          const s = c.league ? seasonOf(c.league) : null;
          return (
            <div class="card" id={c.id}>
              <span class="eyebrow">{c.area}</span>
              <strong class="nm">{c.name}</strong>
              <span class="small">{nbsp(t(c.description ?? c.summary, lang), lang)}</span>
              <span class="links">
                {s && <a href={L(`/ligy/${s.code}/`, lang)}>{tr(lang, 'Výsledky', 'Results')}</a>}
                {c.link?.competition && <a href={L(`/vysledky/${c.link.competition}/`, lang)}>{tr(lang, 'Výsledky', 'Results')}</a>}
                {c.web && <a href={c.web} rel="noopener">{tr(lang, "Web klubu", "Club website")}</a>}
                {c.email && <a href={`mailto:${c.email}`}>{c.email}</a>}
              </span>
            </div>
          );
        })}
      </div>
    </section>
    <section class="card-navy">
      <h2>{tr(lang, 'Nemáš ligu poblíž?', 'No league near you?')}</h2>
      <p class="muted">{tr(lang, 'Rádi pomůžeme založit klub nebo ligu ve tvém městě.', 'We are happy to help you start a club or a league in your town.')}</p>
      <a class="btn btn-red" style="align-self: flex-start" href={`mailto:${m.settings.site?.email}`}>{tr(lang, 'Napiš na', 'Write to')} {m.settings.site?.email}</a>
    </section>
  </div>
</Base>
<style>
  .feature { gap: 14px; }
  .feature h2 { color: #fff; }
  .facts { margin: 0; display: grid; gap: 10px; }
  .facts dt { font-weight: 700; color: #fff; }
  .facts dt a { color: #fff; }
  .facts dd { margin: 0; color: var(--on-navy-muted); font-size: 15px; }
  .nm { font-size: 18px; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 16px; font-weight: 600; }
  .links a { color: var(--red); min-height: 44px; display: inline-flex; align-items: center; }
  @media (min-width: 960px) {
    .feature { padding: 40px; border-radius: 24px; }
    .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .more { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .more .card { padding: 22px; border-radius: 18px; }
  }
</style>
